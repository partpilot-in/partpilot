# Multi-stage Dockerfile for React Client (apps/client)
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/client/package.json ./apps/client/package.json
COPY apps/website/package.json ./apps/website/package.json
RUN pnpm install --frozen-lockfile --filter @partpilot/client...

ARG VITE_API_BASE_URL=http://localhost:8080
ARG VITE_SUPABASE_URL=http://localhost:8080
ARG VITE_SUPABASE_PUBLISHABLE_KEY=dev_mock_publishable_key

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY

COPY apps/client/ ./apps/client/
RUN pnpm --filter @partpilot/client build

# Nginx Stage
FROM nginx:alpine

COPY --from=builder /app/apps/client/dist /usr/share/nginx/html
COPY infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
