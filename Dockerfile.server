# Multi-stage Dockerfile for partpilot-server
FROM rust:latest as builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/partpilot

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY tools ./tools

RUN cargo build --release --bin partpilot-server

# Runtime Stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/partpilot/target/release/partpilot-server /app/partpilot-server

ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

CMD ["/app/partpilot-server"]
