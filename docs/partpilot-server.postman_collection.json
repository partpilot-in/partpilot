{
  "info": {
    "name": "PartPilot API — partpilot-server",
    "description": "Component obsolescence intelligence API. Public read endpoints, Supabase-session BOM and Important-parts endpoints, and an API-key endpoint for the KiCad plugin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b6f0b6d0-2a2a-4f0a-8a0e-partpilot0001"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.bestpartpilot.com",
      "description": "Switch to http://localhost:8080 for local dev"
    },
    {
      "key": "supabase_access_token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "secret"
    },
    {
      "key": "part_id",
      "value": "8e4c1a20-1f3a-4b8e-9e2a-0a1b2c3d4e5f"
    },
    {
      "key": "bom_id",
      "value": "d4e5f6a7-0000-0000-0000-000000000000"
    },
    {
      "key": "compare_bom_id",
      "value": "e5f6a7b8-0000-0000-0000-000000000000"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{supabase_access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Search parts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/search?q=lm317&category=&manufacturer=&lifecycle=&cursor=&limit=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "lm317"
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "manufacturer",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "lifecycle",
                  "value": "",
                  "disabled": true,
                  "description": "active|nrnd|last_time_buy|obsolete|unknown"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "25",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get part detail",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}"
              ]
            }
          }
        },
        {
          "name": "Get part lifecycle history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "history"
              ]
            }
          }
        },
        {
          "name": "Get part alternates",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/alternates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "alternates"
              ]
            }
          }
        },
        {
          "name": "Get part insights (Community Pulse)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/insights",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "insights"
              ]
            }
          }
        },
        {
          "name": "Compare parts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/compare?ids={{part_id}},<second_part_id>",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "compare"
              ],
              "query": [
                {
                  "key": "ids",
                  "value": "{{part_id}},<second_part_id>",
                  "description": "2-8 comma-separated part UUIDs"
                }
              ]
            }
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User (Supabase session)",
      "item": [
        {
          "name": "List BOM projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms"
              ]
            }
          }
        },
        {
          "name": "Upload BOM",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/boms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "name",
                  "value": "",
                  "type": "text",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get BOM risk report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms/{{bom_id}}?sort=score&order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms",
                "{{bom_id}}"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "score",
                  "description": "line_no|description|manufacturer|country_of_origin|category|qty|unit_price|compliance|lifecycle_stage|score"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "asc|desc"
                }
              ]
            }
          }
        },
        {
          "name": "Compare two BOMs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms/{{bom_id}}/compare?with={{compare_bom_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms",
                "{{bom_id}}",
                "compare"
              ],
              "query": [
                {
                  "key": "with",
                  "value": "{{compare_bom_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get important parts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/important-parts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts"
              ]
            }
          }
        },
        {
          "name": "Mark part important",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/important-parts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"part_id\": \"{{part_id}}\"\n}"
            }
          }
        },
        {
          "name": "Unmark part important",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/important-parts/{{part_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts",
                "{{part_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "KiCad plugin (API key)",
      "item": [
        {
          "name": "Lookup part by MPN",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/kicad/lookup?mpn=LM317T&manufacturer=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "kicad",
                "lookup"
              ],
              "query": [
                {
                  "key": "mpn",
                  "value": "LM317T"
                },
                {
                  "key": "manufacturer",
                  "value": "",
                  "disabled": true,
                  "description": "improves match precision"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
