{
  "info": {
    "name": "PartPilot API — partpilot-server",
    "description": "Component obsolescence intelligence API. Public read endpoints, Supabase-session BOM, Important-parts, and Settings endpoints, and an API-key endpoint for the KiCad plugin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b6f0b6d0-2a2a-4f0a-8a0e-partpilot0001"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.bestpartpilot.com",
      "description": "Switch to http://localhost:8080 for local dev"
    },
    {
      "key": "supabase_access_token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "secret"
    },
    {
      "key": "part_id",
      "value": "8e4c1a20-1f3a-4b8e-9e2a-0a1b2c3d4e5f"
    },
    {
      "key": "bom_id",
      "value": "d4e5f6a7-0000-0000-0000-000000000000"
    },
    {
      "key": "compare_bom_id",
      "value": "e5f6a7b8-0000-0000-0000-000000000000"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{supabase_access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Search parts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/search?q=lm317&category=&manufacturer=&lifecycle=&cursor=&limit=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "lm317"
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "manufacturer",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "lifecycle",
                  "value": "",
                  "disabled": true,
                  "description": "active|nrnd|last_time_buy|obsolete|unknown"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "25",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Search and enrich from DigiKey",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns a populated part\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(body.data[0].component_metadata).to.be.an(\"object\");",
                  "  pm.collectionVariables.set(\"part_id\", body.data[0].id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "description": "Searches the PartPilot database first. On an exact catalog miss, a configured server fetches ProductDetails from DigiKey, normalizes and persists the result, then returns the populated API record. The test stores its id in {{part_id}} for the detail request.",
            "url": {
              "raw": "{{base_url}}/v1/parts/search?q=TPS7A49-Q1&manufacturer=Texas%20Instruments&limit=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "TPS7A49-Q1",
                  "description": "Use the original manufacturer part-number spelling; punctuation is preserved for DigiKey."
                },
                {
                  "key": "manufacturer",
                  "value": "Texas Instruments",
                  "description": "Recommended to disambiguate manufacturer part numbers."
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            }
          }
        },
        {
          "name": "Get part detail",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}"
              ]
            }
          }
        },
        {
          "name": "Get part lifecycle history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "history"
              ]
            }
          }
        },
        {
          "name": "Get part alternates",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/alternates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "alternates"
              ]
            }
          }
        },
        {
          "name": "Get part insights (Community Pulse)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/{{part_id}}/insights",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "{{part_id}}",
                "insights"
              ]
            }
          }
        },
        {
          "name": "Compare parts",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/v1/parts/compare?ids={{part_id}},<second_part_id>",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "parts",
                "compare"
              ],
              "query": [
                {
                  "key": "ids",
                  "value": "{{part_id}},<second_part_id>",
                  "description": "2-8 comma-separated part UUIDs"
                }
              ]
            }
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User (Supabase session)",
      "item": [
        {
          "name": "List BOM projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms"
              ]
            }
          }
        },
        {
          "name": "Upload BOM",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/boms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "name",
                  "value": "",
                  "type": "text",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get BOM risk report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms/{{bom_id}}?sort=score&order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms",
                "{{bom_id}}"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "score",
                  "description": "line_no|description|manufacturer|country_of_origin|category|qty|unit_price|compliance|lifecycle_stage|score"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "description": "asc|desc"
                }
              ]
            }
          }
        },
        {
          "name": "Compare two BOMs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/boms/{{bom_id}}/compare?with={{compare_bom_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "boms",
                "{{bom_id}}",
                "compare"
              ],
              "query": [
                {
                  "key": "with",
                  "value": "{{compare_bom_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get important parts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/important-parts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts"
              ]
            }
          }
        },
        {
          "name": "Mark part important",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/important-parts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"part_id\": \"{{part_id}}\"\n}"
            }
          }
        },
        {
          "name": "Unmark part important",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/important-parts/{{part_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "important-parts",
                "{{part_id}}"
              ]
            }
          }
        },
        {
          "name": "Get profile settings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/settings/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "settings",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update profile settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"job\": \"Hardware Engineer\",\n  \"company\": \"PartPilot\",\n  \"linkedin\": \"https://www.linkedin.com/in/jane-doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/settings/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "settings",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Request password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"redirect_to\": \"http://localhost:5173/settings\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/settings/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "settings",
                "reset-password"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "KiCad plugin (API key)",
      "item": [
        {
          "name": "Lookup part by MPN",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/kicad/lookup?mpn=LM317T&manufacturer=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "kicad",
                "lookup"
              ],
              "query": [
                {
                  "key": "mpn",
                  "value": "LM317T"
                },
                {
                  "key": "manufacturer",
                  "value": "",
                  "disabled": true,
                  "description": "improves match precision"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
